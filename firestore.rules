rules_version = '2';

// paste into firebase > firestore > rules
// only my account can change recipes

service cloud.firestore {
  match /databases/{database}/documents {

    function isKari() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "karissma.quinones2004@gmail.com".lower();
    }

    function looksLikeARecipe() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.category in ["cooking", "dessert"];
    }

    match /recipes/{recipeId} {
      allow read: if true;                                    // anyone can see
      allow create, update: if isKari() && looksLikeARecipe(); // only me
      allow delete: if isKari();                              // only me
    }
  }
}
